<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PulseCheck</AssemblyName>
    <RootNamespace>PulseCheck</RootNamespace>
    <ApplicationIcon>Assets\pulsecheck.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <Product>PulseCheck</Product>
    <Description>PC and network health check, made for new computers</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" />
    <EmbeddedResource Include="Data\*.json" />
    <Resource Include="Assets\pulsecheck.ico" />
  </ItemGroup>

</Project>
